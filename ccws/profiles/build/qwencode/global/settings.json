{
  "general": {
    "preferredEditor": "nvim",
    "enableAutoUpdate": false
  },
  "ui": {
    "hideBanner": true,
    "hideTips": true,
    "showCitations": false,
    "shellOutputMaxLines": 10,
    "enableFollowupSuggestions": false,
    "useTerminalBuffer": false,
    "mouseTracking": false,
    "accessibility": {
      "enableLoadingPhrases": false
    },
    "theme": "Dracula"
  },
  "tools": {
    "approvalMode": "yolo"
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false,
    "enableAutoSkill": false
  },
  "telemetry": {
    "enabled": true,
    "target": "local",
    "otlpEndpoint": "",
    "outfile": "/ccws/workspace/artifacts/qwen/log/telemetry.log",
    "logPrompts": true
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "output": {
    "showTimestamps": true
  },
  "model": {
    "enableOpenAILogging": false,
    "openAILoggingDir": "workspace/artifacts/qwen/log"
  },
  "context": {
    "fileName": [
      "context.md"
    ],
    "includeDirectories": [
      "/ccws/.qwen"
    ],
    "loadFromIncludeDirectories": true,
    "fileFiltering": {
      "respectGitIgnore": false
    }
  },
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "/ccws/ccws/tools/bin/codebase-memory-mcp",
      "args": [],
      "trust": true
    }
  },
  "$version": 4
}
